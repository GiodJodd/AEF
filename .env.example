# Copy to .env.local and fill in. .env.local is gitignored (never committed).
# Full walkthrough: CMS-ACCESS.md

# ── Keystatic CMS (GitHub mode = production editing) ─────────────────────────
# Random string that signs the Keystatic session cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEYSTATIC_SECRET=

# From the GitHub App (CMS-ACCESS.md, Step 1). The PUBLIC slug is what flips
# storage to github (it must be NEXT_PUBLIC_ so the in-browser admin agrees with
# the server).
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Setup-only: forces github mode in dev so the wizard appears before the app
# exists. Remove after setup. Dev-only (ignored in production builds).
# NEXT_PUBLIC_KEYSTATIC_SETUP=true

# ── Optional: analytics + Search Console (unrelated to the CMS) ──────────────
# NEXT_PUBLIC_GA_ID=
# GOOGLE_SITE_VERIFICATION=
